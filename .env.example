# ============================================
# NIDAVELLIR ENVIRONMENT CONFIGURATION
# ============================================

# === OPERATION MODE ===
# Set to 'false' for production with real OpenStack
MOCK_MODE=true

# === OPENSTACK CREDENTIALS ===
# Required when MOCK_MODE=false
OS_AUTH_URL=https://your-openstack-server:5000/v3
OS_USERNAME=your_username
OS_PASSWORD=your_password
OS_PROJECT_ID=your_project_id
OS_REGION_NAME=RegionOne
OS_USER_DOMAIN_NAME=Default
OS_PROJECT_DOMAIN_NAME=Default

# === WORKER CONFIGURATION ===
# Number of max concurrent lab deployments
WORKER_CONCURRENCY=3
WORKER_LOG_LEVEL=INFO

# === LOCAL SOURCE-BUNDLE INTAKE (M4-B2) ===
# Compressed upload, expanded archive, total content-addressed store, and WebUI
# multipart request limits. Defaults: 32 MiB / 128 MiB / 2 GiB / 34 MiB.
# SOURCE_BUNDLE_MAX_UPLOAD_BYTES=33554432
# SOURCE_BUNDLE_MAX_EXPANDED_BYTES=134217728
# SOURCE_BUNDLE_STORE_MAX_BYTES=2147483648
# WEBUI_MAX_UPLOAD_BYTES=35651584

# === AUTHENTICATION (ADR-0002) ===
# API key the stack bootstraps and the WebUI uses to call the orchestrator.
# Generate a real one for any reachable deployment:  openssl rand -hex 24
NIDAVELLIR_API_KEY=dev-insecure-key
# WebUI operator login (defaults are demo-only — change both!)
WEBUI_USERNAME=admin
WEBUI_PASSWORD=nidavellir

# === WEB UI SECURITY ===
SECRET_KEY=random-string

# === SECRETS ENCRYPTION AT REST (audit #14) ===
# Fernet key used to encrypt lab outputs (SOC credentials, SSH commands, IPs)
# in the database. Generate one with:  python -m crypto
# Leave unset for the mock/dev demo (outputs stored in plaintext); set it for
# any real deployment.
# SECRETS_ENCRYPTION_KEY=

# === OPTIONAL: DATABASE ===
# Uncomment to use PostgreSQL instead of SQLite
# DB_PASSWORD=postgres_password

# === DEBUGGING ===
DEBUG_MODE=false
FLASK_ENV=production
